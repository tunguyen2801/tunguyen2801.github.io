---
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Button from '@/components/Button.astro'

const PRODUCTS = [
	{
		heading: 'CRM System',
		subheading:
			'Enterprise CRM with real-time chat modules, WhatsApp integration via WebSocket, RBAC authorization (Casbin), and Kong Gateway for API management.',
		imagePath: '/src/assets/coming-soon.png',
		altText: 'CRM System',
		href: undefined
	},
	{
		heading: 'Marketing Message Distribute System',
		subheading:
			'High-throughput microservice platform running across AWS and GCP. Batch job optimization, Terraform-managed infrastructure, and Kubernetes-based deployment.',
		imagePath: '/src/assets/coming-soon.png',
		altText: 'Marketing Message Distribute System',
		href: undefined
	},
	{
		heading: 'Home Spa Booking App',
		subheading:
			'Full-stack home spa booking product. Golang backend services with a Flutter mobile client for end customers and technicians.',
		imagePath: '/src/assets/coming-soon.png',
		altText: 'Home Spa Booking App',
		href: undefined
	},
	{
		heading: 'Recruitment System (UPP)',
		subheading:
			'Referral code feature end-to-end, serverless workloads on AWS Lambda, and Ruby on Rails backend contributions for the UCTalent recruitment platform.',
		imagePath: '/src/assets/coming-soon.png',
		altText: 'Recruitment System',
		href: undefined
	}
]
---

<PageLayout meta={{ title: 'Mine' }}>
	<div class='w-full'>
		<Button title='Back' href='/' style='button'>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				width='14'
				height='14'
				viewBox='0 0 24 24'
				slot='icon-before'
			>
				<path
					fill='currentColor'
					d='m6.921 12.5l5.792 5.792L12 19l-7-7l7-7l.713.708L6.921 11.5H19v1z'
				>
				</path>
			</svg>
		</Button>

		<div class='mt-5 flex w-full flex-col gap-y-10'>
			<div>
				<h1 class='mb-1 text-2xl font-bold'>Mine</h1>
				<p class='text-muted-foreground'>
					A showcase of software products I've built and contributed to.
				</p>
			</div>

			<div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
				{
					PRODUCTS.map((product) => (
						<ProjectCard
							as={product.href ? 'a' : 'div'}
							href={product.href}
							heading={product.heading}
							subheading={product.subheading}
							imagePath={product.imagePath}
							altText={product.altText}
							class='w-full'
						/>
					))
				}
			</div>
		</div>
	</div>
</PageLayout>
