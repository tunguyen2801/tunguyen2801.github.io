---
import PageLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import Card from '../components/Card.astro'
import ProjectCard from '../components/ProjectCard.astro'
import Label from '../components/Label.astro'
import SkillLayout from '../components/SkillLayout.astro'
import PostPreview from '@/components/blog/PostPreview.astro'

import { Image } from 'astro:assets'
import avatar from '../assets/tunguyen_avatar.png'

import { getAllPosts, sortMDByDate } from '@/utils'

const languages = ['Golang', 'Ruby', 'JavaScript', 'TypeScript', 'Dart']
const frontend = ['Flutter', 'React', 'Next.js']
const backend = ['Golang', 'Ruby on Rails', 'Node.js', 'gRPC', 'RESTful APIs', 'WebSocket', 'Kafka']
const databases = ['MySQL', 'PostgreSQL', 'MongoDB', 'Elasticsearch', 'Redis']
const others = [
	'AWS',
	'GCP',
	'Docker',
	'Kubernetes',
	'Terraform',
	'AWS Lambda',
	'Kong Gateway',
	'Casbin (RBAC)',
	'OAuth 2',
	'CI/CD',
]

const MAX_POSTS = 10
const allPosts = await getAllPosts()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Tu Nguyen' }}>
	<div class='flex w-full flex-col gap-y-10'>
		<section class='flex flex-col items-center'>
			<div class='group relative flex w-full flex-col items-center'>
				<div
					class='manga-bubble pointer-events-none absolute inset-x-0 bottom-[calc(100%-2rem)] z-10 flex justify-center sm:right-auto sm:left-1/2 sm:block'
				>
					<div
						class='relative w-max max-w-full whitespace-nowrap rounded-2xl border-[3px] border-foreground bg-background px-4 py-2 text-sm font-bold tracking-wide text-foreground shadow-[4px_4px_0_0_hsl(var(--foreground))] sm:max-w-[24rem]'
					>
						I'm a Software Engineer
						<span
							class='absolute -bottom-[11px] left-1/2 -ml-2 h-4 w-4 rotate-45 border-b-[3px] border-r-[3px] border-foreground bg-background sm:left-6 sm:ml-0'
						></span>
					</div>
				</div>

				<Image
					src={avatar}
					alt='profile photo'
					class='h-auto w-[13.5rem] max-w-full cursor-pointer'
					loading='eager'
				/>
				<h1 class='cursor-pointer text-4xl font-bold text-foreground'>TU NGUYEN</h1>
			</div>

			<div class='mt-4 flex flex-col items-center gap-y-4'>
				<div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
					<Label title='Techvify'>
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M4.615 20q-.69 0-1.152-.462Q3 19.075 3 18.385v-9.77q0-.69.463-1.152Q3.925 7 4.615 7H9V5.615q0-.69.463-1.152Q9.925 4 10.615 4h2.77q.69 0 1.153.463q.462.462.462 1.152V7h4.385q.69 0 1.152.463q.463.462.463 1.152v9.77q0 .69-.462 1.152q-.463.463-1.153.463zm0-1h14.77q.23 0 .423-.192q.192-.193.192-.423v-9.77q0-.23-.192-.423Q19.615 8 19.385 8H4.615q-.23 0-.423.192Q4 8.385 4 8.615v9.77q0 .23.192.423q.193.192.423.192M10 7h4V5.615q0-.23-.192-.423Q13.615 5 13.385 5h-2.77q-.23 0-.423.192q-.192.193-.192.423zM4 19V8z'
							></path></svg
						>
					</Label>
					<Label title='Da Nang'>
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M5 20h3.654v-5.019q0-.402.28-.681q.278-.279.68-.279h4.772q.402 0 .681.28q.279.278.279.68V20H19v-9.692l-6.807-5.135q-.096-.077-.192-.077t-.193.077L5 10.308zm-1 1V9.808l7.402-5.581q.267-.196.58-.294q.315-.098.624-.098t.617.098t.567.294L20 9.808V21h-5.654v-5.98H9.654V21z'
							></path></svg
						>
					</Label>
					<Label title='Ha Noi'>
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M12.003 11.73q.668 0 1.14-.475q.472-.475.472-1.143t-.475-1.14q-.476-.472-1.143-.472t-1.14.476q-.472.475-.472 1.143t.475 1.14q.476.472 1.143.472M12 19.677q2.82-2.454 4.458-4.991q1.638-2.538 1.638-4.39q0-2.744-1.737-4.53T12 3.981q-2.621 0-4.359 1.785t-1.737 4.53q0 1.852 1.638 4.39q1.639 2.537 4.458 4.99m0 1.343q-3.525-3.117-5.31-5.814q-1.786-2.697-1.786-4.909q0-3.173 2.066-5.234Q9.037 3 12 3t5.03 2.062q2.066 2.061 2.066 5.234q0 2.212-1.785 4.909q-1.786 2.697-5.311 5.814m0-10.904'
							></path></svg
						>
					</Label>
					<Label
						title='nguyenvantu28011998@gmail.com'
						as='a'
						href='mailto:nguyenvantu28011998@gmail.com'
					>
						<svg
							xmlns='http://www.w3.org/2000/svg'
							viewBox='0 0 24 24'
							slot='icon'
							class='h-5 w-5 text-foreground/75'
							><path
								fill='currentColor'
								d='M4 20q-.825 0-1.412-.587T2 18V6q0-.825.588-1.412T4 4h16q.825 0 1.413.588T22 6v12q0 .825-.587 1.413T20 20zm8-7.15L4 8v10h16V8zm0-1L19.9 7H4.075zM4 8V7v11z'
							></path></svg
						>
					</Label>
					<Label
						title='View on GitHub'
						as='a'
						href='https://github.com/vantu2801se'
						target='_blank'
					>
						<svg
							xmlns='http://www.w3.org/2000/svg'
							viewBox='0 0 24 24'
							slot='icon'
							class='h-5 w-5 text-foreground/75'
							><path
								fill='currentColor'
								d='M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.94c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.84-2.34 4.68-4.57 4.93c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2'
							></path></svg
						>
					</Label>
				</div>
			</div>
		</section>

		<Section title='About'>
			<div class='flex flex-col gap-y-4 text-muted-foreground'>
				<p>
					I have always believed that building software is not simply about writing code, but about
					understanding the system as a whole, identifying what truly matters, and taking ownership
					of complex problems when they arise.
				</p>
				<p>
					Throughout my 5+ years of experience in software development, I have worked across a wide
					range of areas—from building cloud infrastructure and deploying mobile applications to
					developing web platforms for businesses that require stability, scalability, and high
					availability. I have always been comfortable stepping into complex situations,
					understanding the underlying systems, prioritizing what matters most, and focusing on
					delivering products within the right timeframe.
				</p>
				<p>
					As modern AI tools continue to evolve rapidly, many low-level tasks—such as writing code
					and dealing with programming language syntax—will increasingly be handled by AI. This
					allows engineers to spend more of their time working at a higher level, solving more
					meaningful problems and creating greater value.
				</p>
				<p>
					However, I do not believe this means we should simply hand everything over to AI.
					Regardless of how software is built, an engineer is ultimately responsible for making
					sure that the software works correctly, reliably, and as intended. That, to me, is the
					minimum standard of engineering.
				</p>
				<p>
					This portfolio is not only a showcase of my work and experience, but also a place where I
					share the knowledge, lessons, and perspectives I have gained throughout my journey in
					software development.
				</p>
			</div>
		</Section>

		<Section title='Experience'>
			<Card
				heading='IDO E-commerce Services'
				subheading='Golang Backend Senior — CRM System'
				date='May 2025 - Present'
				imagePath='/src/assets/about-astro.png'
				altText='IDO E-commerce Services'
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>Built chat modules with WhatsApp integration via WebSocket.</li>
					<li>Redesigned user authorization using RBAC (Casbin) and integrated Kong Gateway.</li>
					<li>Delivered full-stack work on a home spa booking application.</li>
					<li>Implemented RFM reporting and OAuth 2 authentication flows.</li>
				</ul>
			</Card>
			<Card
				heading='DAC Data Technology Vietnam JSC'
				subheading='Golang Backend Developer — Marketing Message Distribute System'
				date='Jan 2022 - Apr 2025'
				imagePath='/src/assets/about-astro.png'
				altText='DAC Data Technology Vietnam'
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>Designed and developed microservices for high-throughput message distribution.</li>
					<li>Built multi-cloud communication across AWS and GCP.</li>
					<li>Optimized batch jobs and authored system design documentation.</li>
					<li>Provisioned infrastructure with Terraform and set up CI/CD pipelines.</li>
					<li>Deployed and operated services on Kubernetes.</li>
				</ul>
			</Card>
			<Card
				heading='UCTalent Labs'
				subheading='Golang Backend Developer (Part-time) — Recruitment System'
				date='Jun 2023 - Jan 2024'
				imagePath='/src/assets/about-astro.png'
				altText='UCTalent Labs'
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>Implemented the referral code feature end-to-end.</li>
					<li>Deployed serverless workloads with AWS Lambda.</li>
					<li>Contributed to Ruby on Rails backend development.</li>
				</ul>
			</Card>
		</Section>

		<Section title='Education'>
			<Card
				heading='Danang University of Science and Technology'
				subheading='Information Technology'
				date='Graduated Apr 2022'
				imagePath='/src/assets/about-astro.png'
				altText='Danang University of Science and Technology'
				imageClass='h-12 w-auto md:-left-16'
			/>
		</Section>

		<Section title='Projects'>
			<div class='flex flex-col gap-y-3 sm:flex-row sm:gap-x-3 sm:gap-y-0'>
				<ProjectCard
					as='div'
					heading='CRM System'
					subheading='Chat modules with WhatsApp integration via WebSocket, RBAC authorization with Casbin, and Kong Gateway integration.'
					imagePath='/src/assets/coming-soon.png'
					altText='CRM System'
					class='w-full sm:w-1/2'
				/>
				<ProjectCard
					as='div'
					heading='Marketing Message Distribute System'
					subheading='Microservice architecture running across AWS and GCP, batch job optimization, Terraform-provisioned infrastructure, and Kubernetes deployment.'
					imagePath='/src/assets/coming-soon.png'
					altText='Marketing Message Distribute System'
					class='w-full sm:w-1/2'
				/>
			</div>
			<div class='flex flex-col gap-y-3 sm:flex-row sm:gap-x-3 sm:gap-y-0'>
				<ProjectCard
					as='div'
					heading='Home Spa Booking App'
					subheading='Full-stack home spa booking application built with Golang backend and Flutter mobile client.'
					imagePath='/src/assets/coming-soon.png'
					altText='Home Spa Booking App'
					class='w-full sm:w-1/2'
				/>
				<ProjectCard
					as='div'
					heading='Recruitment System (UPP)'
					subheading='Referral code feature implementation, serverless workloads on AWS Lambda, and Ruby on Rails backend contributions.'
					imagePath='/src/assets/coming-soon.png'
					altText='Recruitment System'
					class='w-full sm:w-1/2'
				/>
			</div>
		</Section>

		<Section title='Certifications'>
			<Card
				heading='Professional Scrum Master I (PSM I)'
				subheading='Scrum.org — foundational Scrum framework and Scrum Master accountabilities.'
				date='2022'
				imagePath='/src/assets/about-astro.png'
				altText='PSM I certification'
				imageClass='h-11 w-auto md:-left-16'
			/>
			<Card
				heading='JLPT N3'
				subheading='Japanese-Language Proficiency Test — intermediate level.'
				date='2023'
				imagePath='/src/assets/about-astro.png'
				altText='JLPT N3 certification'
				imageClass='h-11 w-auto md:-left-16'
			/>
		</Section>

		<Section title='Skills'>
			<SkillLayout title='Languages' skills={languages} />
			<SkillLayout title='Backend' skills={backend} />
			<SkillLayout title='Frontend' skills={frontend} />
			<SkillLayout title='Databases' skills={databases} />
			<SkillLayout title='Cloud / DevOps / Others' skills={others} />
		</Section>

		{
			allPostsByDate.length > 0 && (
				<Section title='Posts'>
					<ul class='flex flex-col gap-y-2'>
						{allPostsByDate.map((p) => (
							<li class='flex flex-col gap-x-2 sm:flex-row'>
								<PostPreview post={p} />
							</li>
						))}
					</ul>
				</Section>
			)
		}
	</div>
</PageLayout>

<style>
	.manga-bubble {
		opacity: 0;
		visibility: hidden;
		transform: translateY(10px) scale(0.6) rotate(6deg);
		transform-origin: bottom left;
	}

	.group:hover .manga-bubble,
	.group:active .manga-bubble {
		visibility: visible;
		animation: manga-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}

	@keyframes manga-pop {
		0% {
			opacity: 0;
			transform: translateY(10px) scale(0.6) rotate(6deg);
		}
		60% {
			opacity: 1;
			transform: translateY(0) scale(1.08) rotate(-5deg);
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1) rotate(-3deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.group:hover .manga-bubble,
		.group:active .manga-bubble {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
